{
  "name": "employee-portal-backend",
  "version": "0.1.0",
  "private": true,
  "description": "One-Point Employee Portal backend (Node.js + Express + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "tsx watch src/backend/app/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/backend/app/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "roots": [
      "<rootDir>/tests/backend"
    ],
    "testMatch": [
      "**/*.test.ts"
    ]
  }
}
