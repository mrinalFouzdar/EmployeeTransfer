generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Dev-seed reference data (BR-08 controlled lists) ---------------------
// Real system of record is the HR / Core HCM system (BRD.md Q19). These
// tables exist only to unblock local dev/test until a sync mechanism is
// built - not a business module of their own.

model Department {
  id   String @id @default(uuid())
  name String @unique

  currentRequests  TransferRequest[] @relation("CurrentDepartment")
  proposedRequests TransferRequest[] @relation("ProposedDepartment")
  employeeProfiles EmployeeProfileSeed[]
}

model Location {
  id   String @id @default(uuid())
  name String @unique

  currentRequests  TransferRequest[] @relation("CurrentLocation")
  proposedRequests TransferRequest[] @relation("ProposedLocation")
  employeeProfiles EmployeeProfileSeed[]
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  currentRequests  TransferRequest[] @relation("CurrentRole")
  proposedRequests TransferRequest[] @relation("ProposedRole")
  employeeProfiles EmployeeProfileSeed[]
}

// Dev-seed data backing the local `EmployeeProfileProvider` adapter only.
// NOT the employees/org business module - no BRD has established one yet.
// Real system of record is the HR / Core HCM system (BRD.md Q19); this table
// is explicitly deferred infrastructure per
// .ai-context/plans/internal-transfer-request.plan.md "Explicitly Deferred".
model EmployeeProfileSeed {
  employeeId String  @id
  // Display name for the seeded demo data only - EmployeeProfile itself (BR-30/32-adjacent)
  // never exposes this beyond what the UI needs to show "who am I acting as."
  name       String?

  currentDepartmentId String
  currentLocationId   String
  currentRoleId       String
  managerId           String

  currentDepartment Department @relation(fields: [currentDepartmentId], references: [id])
  currentLocation   Location   @relation(fields: [currentLocationId], references: [id])
  currentRole       Role       @relation(fields: [currentRoleId], references: [id])

  hireDate                   DateTime
  probationEndDate           DateTime?
  probationExceptionApproved Boolean   @default(false)
  lastTransferCompletedAt    DateTime?

  // BR-01/BR-04 (AC32/AC33, added 2026-09-13 - see Spec's Gate 1 Re-Review log): these two
  // eligibility rules were "Confirmed intent" in the BRD from the start but were never
  // carried into the original Gate-1-approved Spec's Acceptance Criteria, so they were never
  // implemented until now.
  isActive                     Boolean @default(true)
  hasActiveDisciplinaryProcess Boolean @default(false)
  disciplinaryOverrideApproved Boolean @default(false)
}

// --- Core domain ------------------------------------------------------------

enum TransferStatus {
  DRAFT
  SUBMITTED
  MANAGER_CONFIRMED
  RETURNED_FOR_AMENDMENT
  UNDER_HR_REVIEW
  APPROVED_IN_PROGRESS
  PENDING_ACTION
  ON_HOLD
  COMPLETED
  REJECTED
  WITHDRAWN
}

model TransferRequest {
  id String @id @default(uuid())

  employeeId String

  currentDepartmentId  String
  currentLocationId    String
  currentRoleId        String
  proposedDepartmentId String
  proposedLocationId   String
  proposedRoleId       String

  currentDepartment  Department @relation("CurrentDepartment", fields: [currentDepartmentId], references: [id])
  currentLocation    Location   @relation("CurrentLocation", fields: [currentLocationId], references: [id])
  currentRole        Role       @relation("CurrentRole", fields: [currentRoleId], references: [id])
  proposedDepartment Department @relation("ProposedDepartment", fields: [proposedDepartmentId], references: [id])
  proposedLocation   Location   @relation("ProposedLocation", fields: [proposedLocationId], references: [id])
  proposedRole       Role       @relation("ProposedRole", fields: [proposedRoleId], references: [id])

  effectiveDate DateTime
  reason        String?
  status        TransferStatus @default(DRAFT)

  // Resolved at submission time from EmployeeProfileProvider (BR-15/BR-17). Null means no
  // manager could be resolved (e.g. self-approval anomaly - see LocalEmployeeProfileProvider
  // callers) and requires manual HR routing; there is no deeper org hierarchy data source in
  // this system to auto-resolve a "next level" manager.
  assignedManagerId String?
  // Optional, employee-supplied at submission (BR-16). No system data source names "the
  // manager of target department X" - this is deliberately captured from the requester
  // rather than invented, since the BRD/Discovery Analysis does not establish one either.
  receivingManagerId String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  managerDecisions ManagerDecision[]
  hrDecision       HrDecision?
  fulfilmentTasks  FulfilmentTask[]
  auditEvents      AuditEvent[]

  @@index([employeeId])
}

enum ManagerRole {
  CURRENT
  RECEIVING
}

enum ManagerDecisionType {
  CONFIRM
  DECLINE
  RETURN
}

model ManagerDecision {
  id String @id @default(uuid())

  requestId String
  request   TransferRequest @relation(fields: [requestId], references: [id])

  managerRole ManagerRole
  managerId   String
  decision    ManagerDecisionType
  reason      String?
  decidedAt   DateTime            @default(now())

  @@index([requestId])
}

enum HrDecisionType {
  ELIGIBLE
  NOT_ELIGIBLE
  ELIGIBLE_WITH_CONDITIONS
}

model HrDecision {
  id String @id @default(uuid())

  requestId String          @unique
  request   TransferRequest @relation(fields: [requestId], references: [id])

  decision   HrDecisionType
  reason     String?
  conditions String?
  decidedAt  DateTime       @default(now())
}

enum FulfilmentTaskType {
  PAYROLL
  IT
  FACILITIES
}

enum FulfilmentTaskStatus {
  NOT_APPLICABLE
  IN_PROGRESS
  COMPLETE
  FAILED
}

model FulfilmentTask {
  id String @id @default(uuid())

  requestId String
  request   TransferRequest @relation(fields: [requestId], references: [id])

  taskType  FulfilmentTaskType
  status    FulfilmentTaskStatus @default(NOT_APPLICABLE)
  note      String?
  updatedAt DateTime             @updatedAt

  @@unique([requestId, taskType])
}

model AuditEvent {
  id String @id @default(uuid())

  requestId String
  request   TransferRequest @relation(fields: [requestId], references: [id])

  actor     String
  action    String
  decision  String?
  reason    String?
  timestamp DateTime @default(now())

  @@index([requestId])
}
